<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Atmospheric Dynamic Theme Background -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_card"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: V A N T A Mark + Live Resolution Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_brand_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_dot_accent"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_brand_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="V A N T A"
                    android:textColor="#D9FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_hires"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="24-BIT HI-RES"
                android:textColor="#FFE5A93C"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Middle Content: Album Artwork & Metadata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/widget_artwork_rounded"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:contentDescription="Album Artwork" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VANTA Music"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pure Bit-Perfect Audio"
                    android:textColor="#D1D1D6"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_album"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Select music to play"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Bar Indicator -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar" />

        <!-- Bottom Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#8E8E93"
                android:textSize="10sp"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_glass_circle"
                android:src="@drawable/ic_widget_prev"
                android:scaleType="centerInside"
                android:contentDescription="Previous Track" />

            <ImageView
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:scaleType="fitXY"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn_glass_circle"
                android:src="@drawable/ic_widget_next"
                android:scaleType="centerInside"
                android:contentDescription="Next Track" />

            <ImageButton
                android:id="@+id/widget_btn_favorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_btn_glass_circle"
                android:src="@drawable/ic_widget_heart"
                android:scaleType="centerInside"
                android:contentDescription="Favorite" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
