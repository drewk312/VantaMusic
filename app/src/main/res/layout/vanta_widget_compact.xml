<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Atmospheric Dynamic Background -->
    <ImageView
        android:id="@+id/widget_compact_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_pill"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_compact_artwork"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_artwork_rounded"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:contentDescription="Album Artwork" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_compact_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VANTA Music"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_compact_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select music to play"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_compact_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_badge_hires"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="HI-RES"
                    android:textColor="#FFE5A93C"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_compact_btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_glass_circle"
            android:src="@drawable/ic_widget_prev"
            android:scaleType="centerInside"
            android:contentDescription="Previous Track" />

        <ImageView
            android:id="@+id/widget_compact_btn_play_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:scaleType="fitXY"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/widget_compact_btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_glass_circle"
            android:src="@drawable/ic_widget_next"
            android:scaleType="centerInside"
            android:contentDescription="Next Track" />
    </LinearLayout>
</FrameLayout>
