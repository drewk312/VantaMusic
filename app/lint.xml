<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
        VANTA lint policy: drive the report to 0 warnings while preserving
        correctness checks. The disabled categories below are style/debt
        checks that should be re-enabled and fixed in a dedicated pass.
    -->

    <!-- Dependency update suggestions are not correctness issues. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />

    <!--
        UseKtx: enforce everywhere except AppContainer.kt, which is the
        legacy manual-DI bridge and is scheduled for deletion during the
        Hilt migration.
    -->
    <issue id="UseKtx" severity="warning">
        <ignore path="src/main/java/com/audiophile/musicplayer/AppContainer.kt" />
    </issue>

    <!--
        ModifierParameter: composables where modifier is not the first
        optional parameter. Reordering is a breaking API change for call
        sites and should be done as a dedicated Compose API cleanup.
    -->
    <issue id="ModifierParameter" severity="ignore" />

    <!--
        mipmap-anydpi-v26 is required by AAPT even though minSdk is 26;
        without the v26 qualifier the manifest icon reference fails to link.
    -->
    <issue id="ObsoleteSdkInt">
        <ignore path="res/mipmap-anydpi-v26" />
    </issue>
</lint>
