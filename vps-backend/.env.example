VANTA_BACKEND_API_KEY=replace-with-a-long-random-secret
QOBUZ_AUTH_TOKEN=your-licensed-qobuz-user-token
# Optional if automatic public-app credential discovery fails:
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=
# Explicitly off by default; these adapters do not provide verified Atmos.
ALLOW_COMMUNITY_FALLBACKS=false
PORT=8080
